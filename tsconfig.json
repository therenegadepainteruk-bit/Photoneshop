{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "moduleDetection": "legacy",
    "strict": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["core/**/*.js", "engines/**/*.js", "ai/**/*.js", "presets/**/*.js", "ui/**/*.js", "types/**/*.d.ts"],
  "exclude": ["node_modules", "coverage", "test", "scripts"]
}
